{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://portfolio.local/contracts/evaluation-run.schema.json",
  "title": "Retrieval evaluation run",
  "type": "object",
  "required": [
    "runId",
    "status",
    "topK",
    "strategyIds",
    "testCaseIds",
    "documentVersionIds",
    "embeddingVersion",
    "scoreSemantics",
    "metricSemantics",
    "strategies",
    "createdAt",
    "completedAt",
    "elapsedMs",
    "correlationId"
  ],
  "properties": {
    "runId": { "type": "string", "format": "uuid" },
    "status": { "const": "completed" },
    "topK": { "type": "integer", "minimum": 1, "maximum": 10 },
    "strategyIds": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "testCaseIds": { "type": "array", "minItems": 1, "items": { "type": "string", "format": "uuid" } },
    "documentVersionIds": { "type": "array", "minItems": 1, "items": { "type": "string", "format": "uuid" } },
    "embeddingVersion": { "type": "string", "minLength": 10 },
    "scoreSemantics": { "type": "string", "minLength": 10 },
    "metricSemantics": { "type": "string", "minLength": 10 },
    "strategies": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["metrics", "queries"],
        "properties": {
          "metrics": {
            "type": "object",
            "required": ["strategyId", "precisionAtK", "recallAtK", "hitRate", "meanReciprocalRank"],
            "properties": {
              "strategyId": { "type": "string" },
              "precisionAtK": { "type": "number", "minimum": 0, "maximum": 1 },
              "recallAtK": { "type": "number", "minimum": 0, "maximum": 1 },
              "hitRate": { "type": "number", "minimum": 0, "maximum": 1 },
              "meanReciprocalRank": { "type": "number", "minimum": 0, "maximum": 1 }
            }
          },
          "queries": { "type": "array", "minItems": 1 }
        }
      }
    },
    "createdAt": { "type": "string", "format": "date-time" },
    "completedAt": { "type": "string", "format": "date-time" },
    "elapsedMs": { "type": "number", "minimum": 0 },
    "correlationId": { "type": "string", "format": "uuid" }
  },
  "additionalProperties": false
}
