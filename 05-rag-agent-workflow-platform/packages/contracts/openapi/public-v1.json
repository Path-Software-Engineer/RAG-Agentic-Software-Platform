                  "title",
                  "source",
                  "file"
                ],
                "properties": {
                  "title": {
                    "type": "string",
                    "maxLength": 200
                  },
                  "source": {
                    "type": "string",
                    "maxLength": 500
                  },
                  "file": {
                    "type": "string",
                    "format": "binary"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DocumentResource"
                }
              }
            }
          }
        },
        "tags": [
          "documents"
        ]
      },
