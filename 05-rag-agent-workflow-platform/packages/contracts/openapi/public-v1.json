          "relevant": {
            "type": "boolean"
          },
          "relevanceSource": {
            "type": "string"
          },
          "relevanceNotes": {
            "type": "object",
            "nullable": true
          }
        },
        "required": [
          "resultId",
          "rank",
          "score",
          "documentId",
          "documentVersionId",
          "chunkId",
          "title",
          "source",
          "snippet",
          "locator",
          "relevant",
          "relevanceSource",
          "relevanceNotes"
        ]
      },
      "EvaluationQueryResource": {
