  "info": {
    "title": "RAG & Agent Workflow Platform API",
    "description": "Public document, retrieval evaluation and governed Agent Workflow Trace Viewer contract.",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "DocumentResource": {
        "type": "object",
        "properties": {
          "documentId": {
            "type": "string"
          },
          "documentVersionId": {
            "type": "string"
          },
          "jobId": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "filename": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "queued",
              "running",
              "completed",
              "failed"
            ]
          },
          "chunkCount": {
            "type": "number"
          },
          "embeddingVersionId": {
            "type": "object",
            "nullable": true
          },
          "createdAt": {
            "type": "string"
          },
          "correlationId": {
            "type": "string"
          },
          "deduplicated": {
            "type": "boolean"
          }
        },
        "required": [
          "documentId",
          "documentVersionId",
          "jobId",
          "title",
          "source",
          "filename",
          "status",
          "chunkCount",
          "embeddingVersionId",
          "createdAt",
          "correlationId",
          "deduplicated"
        ]
      },
      "SearchRequestDto": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "example": "How should retrieved instructions be treated?"
          },
          "topK": {
            "type": "object",
            "default": 5,
            "minimum": 1,
            "maximum": 10
          },
          "documentIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "documentVersionIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "query",
          "topK"
        ]
      },
      "SearchResultResource": {
        "type": "object",
        "properties": {
          "rank": {
            "type": "number"
          },
          "score": {
            "type": "number"
          },
          "documentId": {
            "type": "string"
          },
          "documentVersionId": {
            "type": "string"
          },
          "chunkId": {
            "type": "string"
          },
          "citationId": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "snippet": {
            "type": "string"
          },
          "locator": {
            "type": "object"
          }
        },
        "required": [
          "rank",
          "score",
          "documentId",
          "documentVersionId",
          "chunkId",
          "citationId",
          "title",
          "source",
          "snippet",
          "locator"
        ]
      },
      "SearchResponseResource": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string"
          },
          "topK": {
            "type": "number"
          },
          "embeddingVersionId": {
            "type": "string"
          },
          "scoreSemantics": {
            "type": "string"
          },
          "elapsedMs": {
            "type": "number"
          },
          "correlationId": {
            "type": "string"
          },
          "results": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SearchResultResource"
            }
          }
        },
        "required": [
          "query",
          "topK",
          "embeddingVersionId",
          "scoreSemantics",
          "elapsedMs",
          "correlationId",
          "results"
        ]
      },
      "CitationResource": {
        "type": "object",
        "properties": {
          "citationId": {
            "type": "string"
          },
          "documentId": {
            "type": "string"
          },
          "documentVersionId": {
            "type": "string"
          },
          "chunkId": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "score": {
            "type": "number"
          },
          "snippet": {
            "type": "string"
          },
          "content": {
            "type": "string"
          },
          "locator": {
            "type": "object"
          },
          "correlationId": {
            "type": "string"
          }
        },
        "required": [
          "citationId",
          "documentId",
          "documentVersionId",
          "chunkId",
          "title",
          "source",
          "score",
          "snippet",
          "content",
          "locator",
          "correlationId"
        ]
      },
      "EvaluationStrategyResource": {
        "type": "object",
        "properties": {
          "strategyId": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "chunkSize": {
            "type": "number"
          },
          "overlap": {
            "type": "number"
          },
          "boundary": {
            "type": "string"
          }
        },
        "required": [
          "strategyId",
          "label",
          "description",
          "chunkSize",
          "overlap",
          "boundary"
        ]
      },
      "EvaluationTestCaseResource": {
        "type": "object",
        "properties": {
          "testCaseId": {
            "type": "string"
          },
          "query": {
            "type": "string"
          },
          "relevantDocumentIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "rationale": {
            "type": "string"
          },
          "createdAt": {
            "type": "string"
          }
        },
        "required": [
          "testCaseId",
          "query",
          "relevantDocumentIds",
          "rationale",
          "createdAt"
        ]
      },
      "CreateEvaluationTestCaseDto": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "example": "How must retrieved instructions be treated?"
          },
          "relevantDocumentIds": {
            "description": "Document-level relevance ground truth.",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "rationale": {
            "type": "string",
            "example": "The safety document contains the expected policy."
          }
        },
        "required": [
          "query",
          "relevantDocumentIds",
          "rationale"
        ]
      },
      "EvaluationRunSummaryResource": {
        "type": "object",
        "properties": {
          "runId": {
            "type": "string"
