          },
          "top_k": {
            "type": "integer",
            "title": "Top K"
          },
          "strategy_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Strategy Ids"
          },
          "test_case_ids": {
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "type": "array",
            "title": "Test Case Ids"
          },
          "document_version_ids": {
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "type": "array",
            "title": "Document Version Ids"
          },
          "embedding_version": {
            "type": "string",
            "title": "Embedding Version"
          },
          "score_semantics": {
            "type": "string",
            "title": "Score Semantics"
          },
          "metric_semantics": {
            "type": "string",
            "title": "Metric Semantics"
          },
          "strategies": {
            "items": {
              "$ref": "#/components/schemas/EvaluationStrategyResult"
            },
            "type": "array",
            "title": "Strategies"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "completed_at": {
            "type": "string",
            "format": "date-time",
            "title": "Completed At"
          },
          "elapsed_ms": {
            "type": "number",
            "minimum": 0.0,
            "title": "Elapsed Ms"
          },
          "correlation_id": {
            "type": "string",
            "format": "uuid",
            "title": "Correlation Id"
          }
        },
        "type": "object",
        "required": [
          "run_id",
          "status",
          "top_k",
          "strategy_ids",
          "test_case_ids",
          "document_version_ids",
          "embedding_version",
          "score_semantics",
          "metric_semantics",
          "strategies",
          "created_at",
          "completed_at",
          "elapsed_ms",
          "correlation_id"
        ],
        "title": "EvaluationRunResource"
      },
