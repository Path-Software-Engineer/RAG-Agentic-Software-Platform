  "components": {
    "schemas": {
      "ChunkingStrategyResource": {
        "properties": {
          "strategy_id": {
            "type": "string",
            "pattern": "^[a-z0-9-]{3,40}$",
            "title": "Strategy Id"
          },
          "label": {
            "type": "string",
            "maxLength": 80,
            "minLength": 3,
            "title": "Label"
          },
          "description": {
            "type": "string",
            "maxLength": 300,
            "minLength": 10,
            "title": "Description"
          },
          "chunk_size": {
            "type": "integer",
            "maximum": 2000.0,
            "minimum": 120.0,
            "title": "Chunk Size"
          },
          "overlap": {
            "type": "integer",
            "maximum": 500.0,
            "minimum": 0.0,
            "title": "Overlap"
          },
          "boundary": {
            "type": "string",
            "const": "natural-character-window",
            "title": "Boundary"
          }
        },
        "type": "object",
        "required": [
          "strategy_id",
          "label",
          "description",
          "chunk_size",
          "overlap",
          "boundary"
        ],
        "title": "ChunkingStrategyResource"
      },
      "CitationResponse": {
        "properties": {
          "citation_id": {
            "type": "string",
