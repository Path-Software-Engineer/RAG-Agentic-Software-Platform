          "document_id": {
            "type": "string",
            "format": "uuid",
            "title": "Document Id"
          },
          "document_version_id": {
            "type": "string",
            "format": "uuid",
            "title": "Document Version Id"
          },
          "chunk_id": {
            "type": "string",
            "format": "uuid",
            "title": "Chunk Id"
          },
          "score": {
            "type": "number",
            "maximum": 1.0,
            "minimum": -1.0,
            "title": "Score"
          },
          "snippet": {
            "type": "string",
            "title": "Snippet"
          },
          "content": {
            "type": "string",
            "title": "Content"
          },
          "locator": {
            "additionalProperties": true,
            "type": "object",
            "title": "Locator"
          }
        },
        "type": "object",
        "required": [
          "citation_id",
          "document_id",
          "document_version_id",
          "chunk_id",
          "score",
          "snippet",
          "content",
          "locator"
        ],
        "title": "CitationResponse"
      },
      "EvaluationHit": {
        "properties": {
          "result_id": {
            "type": "string",
            "format": "uuid",
            "title": "Result Id"
          },
          "rank": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Rank"
          },
          "score": {
            "type": "number",
            "maximum": 1.0,
            "minimum": -1.0,
            "title": "Score"
          },
          "document_id": {
            "type": "string",
            "format": "uuid",
            "title": "Document Id"
          },
          "document_version_id": {
            "type": "string",
            "format": "uuid",
            "title": "Document Version Id"
          },
          "chunk_id": {
            "type": "string",
            "format": "uuid",
            "title": "Chunk Id"
          },
          "snippet": {
            "type": "string",
            "title": "Snippet"
          },
          "locator": {
            "additionalProperties": true,
            "type": "object",
            "title": "Locator"
          },
          "relevant": {
            "type": "boolean",
            "title": "Relevant"
          },
          "relevance_source": {
            "type": "string",
            "enum": [
              "expected-set",
              "manual"
            ],
            "title": "Relevance Source",
            "default": "expected-set"
          },
          "relevance_notes": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Relevance Notes"
          }
        },
        "type": "object",
        "required": [
          "result_id",
          "rank",
          "score",
          "document_id",
          "document_version_id",
          "chunk_id",
          "snippet",
          "locator",
          "relevant"
        ],
        "title": "EvaluationHit"
      },
      "EvaluationQueryResult": {
        "properties": {
          "test_case_id": {
            "type": "string",
            "format": "uuid",
            "title": "Test Case Id"
          },
          "query": {
            "type": "string",
            "title": "Query"
          },
          "expected_document_ids": {
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "type": "array",
            "title": "Expected Document Ids"
          },
          "precision_at_k": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Precision At K"
          },
          "recall_at_k": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Recall At K"
          },
          "hit": {
            "type": "boolean",
            "title": "Hit"
          },
          "reciprocal_rank": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Reciprocal Rank"
          },
          "results": {
            "items": {
              "$ref": "#/components/schemas/EvaluationHit"
            },
            "type": "array",
            "title": "Results"
          }
        },
        "type": "object",
        "required": [
          "test_case_id",
          "query",
          "expected_document_ids",
          "precision_at_k",
          "recall_at_k",
          "hit",
          "reciprocal_rank",
          "results"
        ],
        "title": "EvaluationQueryResult"
      },
      "EvaluationRunRequest": {
        "properties": {
          "strategy_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 5,
            "minItems": 1,
            "title": "Strategy Ids"
          },
          "test_case_ids": {
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "type": "array",
            "maxItems": 100,
            "title": "Test Case Ids"
          },
          "document_version_ids": {
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "type": "array",
            "maxItems": 100,
            "title": "Document Version Ids"
          },
          "top_k": {
            "type": "integer",
            "maximum": 10.0,
            "minimum": 1.0,
            "title": "Top K",
            "default": 5
          },
          "correlation_id": {
            "type": "string",
            "format": "uuid",
            "title": "Correlation Id"
          }
        },
        "type": "object",
        "required": [
          "strategy_ids",
          "correlation_id"
        ],
        "title": "EvaluationRunRequest"
      },
      "EvaluationRunResource": {
        "properties": {
          "run_id": {
            "type": "string",
            "format": "uuid",
            "title": "Run Id"
          },
          "status": {
            "type": "string",
            "const": "completed",
