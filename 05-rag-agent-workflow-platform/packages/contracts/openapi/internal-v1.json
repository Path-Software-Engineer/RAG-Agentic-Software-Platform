  "components": {
    "schemas": {
      "CitationResponse": {
        "properties": {
          "citation_id": {
            "type": "string",
            "format": "uuid",
            "title": "Citation Id"
          },
          "document_id": {
            "type": "string",
            "format": "uuid",
            "title": "Document Id"
          },
          "document_version_id": {
            "type": "string",
            "format": "uuid",
            "title": "Document Version Id"
          },
          "chunk_id": {
            "type": "string",
            "format": "uuid",
            "title": "Chunk Id"
          },
          "score": {
            "type": "number",
            "maximum": 1.0,
            "minimum": -1.0,
            "title": "Score"
          },
          "snippet": {
            "type": "string",
            "title": "Snippet"
          },
          "content": {
            "type": "string",
            "title": "Content"
          },
          "locator": {
            "additionalProperties": true,
            "type": "object",
            "title": "Locator"
          }
        },
        "type": "object",
        "required": [
          "citation_id",
          "document_id",
          "document_version_id",
          "chunk_id",
          "score",
          "snippet",
          "content",
          "locator"
        ],
        "title": "CitationResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "IngestionRequest": {
        "properties": {
          "job_id": {
            "type": "string",
            "format": "uuid",
            "title": "Job Id"
          },
          "document_id": {
            "type": "string",
            "format": "uuid",
            "title": "Document Id"
          },
          "document_version_id": {
            "type": "string",
            "format": "uuid",
            "title": "Document Version Id"
          },
          "filename": {
            "type": "string",
            "maxLength": 255,
            "minLength": 1,
            "title": "Filename"
          },
          "media_type": {
            "type": "string",
            "enum": [
              "text/plain",
              "text/markdown"
            ],
            "title": "Media Type"
          },
          "content": {
            "type": "string",
            "maxLength": 1048576,
            "minLength": 1,
            "title": "Content"
          },
          "content_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "title": "Content Sha256"
          },
          "correlation_id": {
            "type": "string",
            "format": "uuid",
            "title": "Correlation Id"
          }
        },
        "type": "object",
        "required": [
          "job_id",
          "document_id",
          "document_version_id",
          "filename",
          "media_type",
          "content",
          "content_sha256",
          "correlation_id"
        ],
        "title": "IngestionRequest"
      },
      "IngestionResponse": {
        "properties": {
          "job_id": {
            "type": "string",
            "format": "uuid",
            "title": "Job Id"
          },
          "status": {
            "type": "string",
            "enum": [
              "running",
              "completed",
              "failed"
            ],
            "title": "Status"
          },
          "chunk_count": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Chunk Count"
          },
          "embedding_version_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Embedding Version Id"
          },
          "elapsed_ms": {
            "type": "number",
            "minimum": 0.0,
            "title": "Elapsed Ms"
          },
          "correlation_id": {
            "type": "string",
            "format": "uuid",
            "title": "Correlation Id"
          }
        },
        "type": "object",
        "required": [
          "job_id",
          "status",
          "chunk_count",
          "elapsed_ms",
          "correlation_id"
        ],
        "title": "IngestionResponse"
      },
      "IngestionStatus": {
        "properties": {
          "job_id": {
            "type": "string",
            "format": "uuid",
            "title": "Job Id"
          },
          "status": {
            "type": "string",
            "enum": [
              "running",
              "completed",
              "failed"
            ],
            "title": "Status"
          },
          "chunk_count": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Chunk Count"
          },
          "embedding_version_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Embedding Version Id"
          },
          "error_code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error Code"
          },
          "started_at": {
            "type": "string",
            "format": "date-time",
            "title": "Started At"
          },
          "completed_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Completed At"
          }
        },
        "type": "object",
        "required": [
          "job_id",
          "status",
          "chunk_count",
          "started_at"
        ],
        "title": "IngestionStatus"
      },
      "InternalSearchResult": {
        "properties": {
          "rank": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Rank"
          },
          "score": {
            "type": "number",
            "maximum": 1.0,
            "minimum": -1.0,
            "title": "Score"
          },
          "document_id": {
            "type": "string",
            "format": "uuid",
            "title": "Document Id"
          },
          "document_version_id": {
            "type": "string",
            "format": "uuid",
            "title": "Document Version Id"
          },
          "chunk_id": {
            "type": "string",
            "format": "uuid",
            "title": "Chunk Id"
          },
          "citation_id": {
            "type": "string",
            "format": "uuid",
            "title": "Citation Id"
          },
          "snippet": {
            "type": "string",
            "title": "Snippet"
          },
          "locator": {
            "additionalProperties": true,
            "type": "object",
            "title": "Locator"
          }
        },
        "type": "object",
        "required": [
          "rank",
          "score",
          "document_id",
          "document_version_id",
          "chunk_id",
          "citation_id",
          "snippet",
          "locator"
        ],
        "title": "InternalSearchResult"
      },
      "SearchRequest": {
        "properties": {
          "query": {
            "type": "string",
            "maxLength": 500,
            "minLength": 2,
            "title": "Query"
          },
          "top_k": {
            "type": "integer",
            "maximum": 10.0,
            "minimum": 1.0,
            "title": "Top K",
            "default": 5
          },
          "document_ids": {
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "type": "array",
            "maxItems": 50,
            "title": "Document Ids"
          },
          "document_version_ids": {
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "type": "array",
            "maxItems": 50,
            "title": "Document Version Ids"
          },
          "correlation_id": {
            "type": "string",
            "format": "uuid",
            "title": "Correlation Id"
          }
        },
        "type": "object",
        "required": [
          "query",
          "correlation_id"
        ],
        "title": "SearchRequest"
      },
      "SearchResponse": {
        "properties": {
          "query": {
            "type": "string",
            "title": "Query"
          },
          "top_k": {
            "type": "integer",
            "title": "Top K"
          },
          "embedding_version_id": {
            "type": "string",
            "format": "uuid",
            "title": "Embedding Version Id"
          },
          "score_semantics": {
            "type": "string",
            "title": "Score Semantics"
          },
          "results": {
            "items": {
              "$ref": "#/components/schemas/InternalSearchResult"
            },
            "type": "array",
            "title": "Results"
          },
          "elapsed_ms": {
            "type": "number",
            "minimum": 0.0,
            "title": "Elapsed Ms"
          },
          "correlation_id": {
            "type": "string",
            "format": "uuid",
            "title": "Correlation Id"
          }
        },
        "type": "object",
        "required": [
          "query",
          "top_k",
          "embedding_version_id",
          "score_semantics",
          "results",
          "elapsed_ms",
          "correlation_id"
        ],
        "title": "SearchResponse"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
